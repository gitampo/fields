# Backend Environment Variables

# Database
DATABASE_URL="postgresql://fields_user:fields123@localhost:5432/fields_db"

# JWT Secret (genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-secret-key-here-change-in-production"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000,exp://192.168.1.x:19000"

# Email (opzionale, per notifiche)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Payments (opzionale, per Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."
